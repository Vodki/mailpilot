# Secrets de mailpilot. Copier en .env (jamais commité) ou monter des fichiers
# et utiliser la variante NOM_FILE=/chemin/vers/fichier.

# Mot de passe de la boîte OVH Email Pro (IMAP, et SMTP par défaut).
MAILPILOT_IMAP_PASSWORD=
# MAILPILOT_IMAP_PASSWORD_FILE=/run/secrets/imap_password

# Seulement si le mot de passe SMTP diffère de celui d'IMAP.
# MAILPILOT_SMTP_PASSWORD=

# Jeton du bot Telegram (BotFather).
MAILPILOT_TELEGRAM_TOKEN=

# Jeton d'API Todoist (Paramètres > Intégrations > Développeur).
MAILPILOT_TODOIST_TOKEN=

# Authentification de `claude -p` : jeton créé avec `claude setup-token`,
# ou une clé d'API Anthropic (facturation à l'usage).
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Chemin du fichier de configuration (défaut : /config/config.yaml).
# MAILPILOT_CONFIG=/config/config.yaml
